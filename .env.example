# Copy this file to .env.local and fill in the values.

# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Backend / local dev OTP
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Prisma CLI)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Combirds SMS — use the template ID from Combirds dashboard (not the message text)
COMBIRDS_API_KEY=your-combirds-api-key
COMBIRDS_SENDER_ID=TFLSTK
COMBIRDS_TEMPLATE_ID=your-dlt-template-id
COMBIRDS_TEMPLATE_FIRST_VAR=KMS
COMBIRDS_SMS_BASE_URL=https://smsapi.edumarcsms.com

# Local dev: print OTP in terminal when SMS is skipped or fails
DEV_OTP_ECHO=true
